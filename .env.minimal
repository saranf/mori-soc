# ── MORI Core 최소 실행(.env.minimal) ────────────────────────────────────────
# 데모를 넘어 "내 데이터로" 처음 띄울 때 필요한 최소 변수만 모았습니다.
# 전체 옵션(83개)은 .env.example 참고. 여기 없는 값은 코드 기본값을 씁니다.
#
#   cp .env.minimal .env   →  값 채우기  →  docker compose up -d
#   접속: http://localhost:18000/admin  (admin / 아래 비밀번호)
#
# 실사용 진입은 /admin 첫 화면의 "실사용 시작 · 온보딩" 카드가 안내합니다
# (소스 연결 → 경보 처리 → 증적 연결 → 개인정보 스캔 → 감사 패키지).

# ── 1) MORI 코어(필수) — api·worker·postgres ─────────────────────────────────
MORI_DB_PASSWORD=change_this_now            # PostgreSQL 비밀번호(반드시 변경)
MORI_ADMIN_PASSWORD=change_this_now         # admin 로그인 비밀번호(반드시 변경)
MORI_AUTH_ENABLED=true                      # 인증 켜기(실사용은 항상 true)
MORI_DEMO_MODE=false                        # 실데이터 모드(데모 시드 끔)
MORI_DEMO_SEED=0                            # 데모용 인메모리 시드 비활성

# ── 2) 첫 커넥터: Zabbix(서버 경보) — 실검증된 pull 커넥터, 여기부터 권장 ──────
# 채우면 /admin 온보딩 카드에서 [연결 테스트]로 바로 확인됩니다(파일 편집→화면 검증).
MORI_ENABLE_ZABBIX=false                    # 쓸 때 true
MORI_ZABBIX_API_URL=                        # 예: https://zabbix.example/api_jsonrpc.php
MORI_ZABBIX_API_TOKEN=                      # API 토큰(또는 아래 사용자/비번)
# MORI_ZABBIX_USER=
# MORI_ZABBIX_PASSWORD=

# ── 3) (선택) Fleet(PC/노트북 자산) — 실검증된 pull 커넥터 ────────────────────
MORI_ENABLE_FLEET=false
MORI_FLEET_API_URL=                         # 예: https://fleet.example
MORI_FLEET_API_TOKEN=

# ── 4) (선택) 수신형(push) 커넥터 — MORI 가 받기만 함(고객 CI/에이전트가 전송) ──
# Trivy·코드리뷰·Wazuh 는 서버측 설정 없이 /ingest/* 로 수신합니다. 전송 인증 토큰:
MORI_INGEST_TOKEN=                          # 설정 시 push 에 Bearer/X-MORI-Token 필요

# ── 5) (권장) 운영 안전 ──────────────────────────────────────────────────────
# 외부 공개 시 HTTPS 는 docs/HTTPS_SETUP.md 참고. 공개 URL 을 https 로 주면
# 세션 쿠키가 자동으로 Secure 로 승격됩니다.
MORI_PUBLIC_URL=
