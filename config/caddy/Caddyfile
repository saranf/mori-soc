# MORI 전용 HTTPS (Caddy) — 호스트 빈 포트 18443 에서 TLS 종단 → mori-api:8000.
# 80·443 이 다른 서비스(예: lawtoyou nginx)에 점유돼 있어도 충돌 없음(다른 포트).
# 인증서는 certbot(DNS-01)로 발급한 /etc/letsencrypt 를 /certs 로 마운트해 그대로 사용
# (Caddy 자동 ACME 는 끔 — 80/443 이 없어 HTTP-01/ALPN 을 못 쓰므로).
{
	auto_https off
}

:18443 {
	tls /certs/live/mori.example.com/fullchain.pem /certs/live/mori.example.com/privkey.pem
	encode zstd gzip
	reverse_proxy mori-api:8000
}
