PUBLIC_DOMAIN=mori.rmstudio.co.kr
PUBLIC_PORT=37854
GRAFANA_PORT=13000
GRAFANA_URL=http://mori.rmstudio.co.kr:13000
TIMEZONE=Asia/Seoul

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=1234

ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change_this_zabbix_password

FLEET_DB_ROOT_PASSWORD=change_this_mysql_root_password
FLEET_DB_NAME=fleet
FLEET_DB_USER=fleet
FLEET_DB_PASSWORD=change_this_fleet_password
FLEET_SERVER_PRIVATE_KEY=generate_with_openssl_rand_base64_32

ZABBIX_WEB_PORT=18081
FLEET_PORT=1337
WAZUH_DASHBOARD_PORT=8443
MORI_API_PORT=18000
# HTTPS 프록시(mori-caddy) 포트 — `--profile https` 로 기동할 때만 사용(docs/HTTPS_SETUP.md).
MORI_HTTPS_PORT=18443
MORI_DB_NAME=mori_soc
MORI_DB_USER=mori
MORI_DB_PASSWORD=change_this_mori_soc_password
MORI_WORKER_INTERVAL_SECONDS=60

# ══════════════════════════════════════════════════════════════════════════
# 소스 연결 (브라운필드)
#   기본 `docker compose up` 은 MORI 코어(api/worker/postgres)만 띄운다. 아래
#   URL/자격증명만 기존 인프라로 바꾸면 바로 연결된다(번들 소스 불필요).
#   번들 데모 스택까지 함께 띄우려면: docker compose --profile bundled up -d
#   (또는 개별: --profile zabbix / --profile fleet / --profile wazuh)
# ══════════════════════════════════════════════════════════════════════════

# ── Zabbix (라이브 REST 연결 — 설정만으로 즉시 동작) ─────────────────────────
MORI_ENABLE_ZABBIX=true
# 번들 데모: http://zabbix-web:8080/api_jsonrpc.php
# 브라운필드(기존 Zabbix): https://zabbix.your-corp.com/api_jsonrpc.php 로 교체
MORI_ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
# 인증: API 토큰 권장(설정 시 user/password 무시). 없으면 user+password 사용.
MORI_ZABBIX_API_TOKEN=
MORI_ZABBIX_USER=Admin
MORI_ZABBIX_PASSWORD=zabbix
MORI_ZABBIX_TIMEOUT_SECONDS=10
MORI_ZABBIX_HOST_LIMIT=500
MORI_ZABBIX_PROBLEM_LIMIT=500
# ── Zabbix write-back (기본 read-only) ────────────────────────────────────────
# MORI 는 기본적으로 Zabbix 를 읽기만 한다. 아래를 켜면 triage 저장 시
# 해당 Zabbix problem event 에 되돌려 쓴다. 위 API 접속정보를 공유하며,
# 모든 write-back 시도는 성공/실패 관계없이 evidence_events 에 감사기록으로 남는다.
# MODE (상위 호환 레벨):
#   comment_only : [MORI] 코멘트만 추가 (Level 1, 가장 안전 — 권장 기본)
#   ack_comment  : reviewing/resolved 전환 시 event acknowledge + 코멘트 (Level 2)
#                  · acknowledge 는 트리거 read-write 권한 필요
#                  · triage payload의 zabbix_ack(bool)로 상태 무관 강제/해제 가능
#   suppress     : 예외 승인/철회 시 event suppress/unsuppress (Level 3, ack 포함)
#                  · 자동 트리거 아님 — 전용 엔드포인트로만 호출(admin·security 전용)
#                  · POST /alerts/{id}/zabbix/suppress   {minutes?, reason?}  (미지정→무기한)
#                  · POST /alerts/{id}/zabbix/unsuppress {reason?}
# severity change / manual close 는 미지원(운영 리스크).
MORI_ZABBIX_WRITEBACK_ENABLED=false
MORI_ZABBIX_WRITEBACK_MODE=comment_only
# dry-run(안전 롤아웃): true 면 write-back 이 켜져 있어도 실제 Zabbix API 는 호출하지 않고
# '무엇을 되돌려 쓸지'만 evidence_events 에 감사기록(status=dry_run)한다. 실운영 전 검증용.
MORI_ZABBIX_WRITEBACK_DRYRUN=false
MORI_ZABBIX_WRITEBACK_PREFIX=[MORI]

# ── Trivy / CSOP (원격 push — MORI_INGEST_TOKEN 으로 무세션 인제스트) ─────────
# 로컬 리포트 폴링(MORI_ENABLE_TRIVY) 또는 원격 push(POST /ingest/trivy) 중 택1.
MORI_ENABLE_TRIVY=false
MORI_TRIVY_REPORT_GLOB=reports/trivy/*.json
MORI_TRIVY_HOSTNAME=
MORI_TRIVY_HOST_ALIASES=

# ── Fleet (⚠ 라이브 API 폴러 미구현 — Phase 3 예정) ──────────────────────────
# 아래 변수는 연결 스캐폴딩(자리)만 마련. 현재 코드는 읽지 않는다.
# 구현 시 기존 FleetDM 을 URL+토큰만으로 read-only 연결할 예정.
MORI_ENABLE_FLEET=false
MORI_FLEET_API_URL=
MORI_FLEET_API_TOKEN=

# ── Wazuh (⚠ 라이브 API 폴러 미구현 — Phase 3 예정) ──────────────────────────
# Wazuh Manager REST(기본 55000, user/password). 현재 코드는 읽지 않는다(자리만).
MORI_ENABLE_WAZUH=false
MORI_WAZUH_API_URL=
MORI_WAZUH_API_USER=
MORI_WAZUH_API_PASSWORD=

# ── 소스 UI 딥링크 URL (자산/호스트 상세 → 원본 콘솔로 이동) ────────────────────
#   각 소스의 웹 콘솔 URL. 기본값은 MORI 데모 서버지만, **내 서버 URL로 자유롭게 교체**하면
#   MORI 화면의 딥링크(Zabbix/Fleet/Wazuh/Grafana ↗ 버튼)가 내 콘솔로 연결된다.
#   비우면 해당 소스 링크만 숨겨진다(다른 링크는 그대로).
#   - Zabbix: 자산 탭·호스트 상세(서버)의 "Zabbix ↗"  → 호스트 목록 필터 페이지
#   - Fleet:  자산 탭·호스트 상세(PC)의 "Fleet ↗"     → 호스트 검색 페이지
#   - Wazuh:  인프라 현황 위젯의 경보 타일 "Wazuh ↗"
#   - Grafana: 담당 서버 상세 모달의 "Grafana ↗"       → Loki 로그 Explore
MORI_ZABBIX_UI_URL=http://mori.rmstudio.co.kr:18081   # 예: https://zabbix.your-corp.com
MORI_FLEET_UI_URL=http://mori.rmstudio.co.kr:1337     # 예: https://fleet.your-corp.com
MORI_WAZUH_UI_URL=                                    # 예: https://wazuh.your-corp.com (비우면 링크 숨김)
MORI_GRAFANA_URL=http://mori.rmstudio.co.kr:13000     # 예: https://grafana.your-corp.com

# ── LDAP 통합 (OpenLDAP) ──────────────────────────
LDAP_ORGANISATION="MORI SOC"
LDAP_DOMAIN=mori.local
LDAP_ADMIN_PASSWORD=change_this_ldap_admin_password

# MORI API 세션 인증 (true 시 비로그인 접근 차단 → /login 으로 리다이렉트)
# ⚠️ 비우면 인증이 꺼져 모든 API·대시보드가 무인증 공개된다(부팅 시 경고 로그). 운영은 반드시 true.
# 운영 모드(MORI_DEMO_MODE=false)에서 인증이 꺼져 있으면 앱이 부팅을 거부한다(fail-closed).
MORI_AUTH_ENABLED=true

# 데모 모드. false 로 두면 '운영 모드' — 인증 미설정 시 부팅 거부, 스키마 fail-fast 활성.
MORI_DEMO_MODE=true

# 스키마 적용 실패 시 부팅 중단 여부(불완전 DB 로 서비스 방지). 미설정 시 운영 모드=true.
# MORI_SCHEMA_FAIL_FAST=true

# (운영에서 의도적으로 인증을 끄려는 경우만) fail-closed 우회. 위험하니 기본 미설정.
# MORI_ALLOW_INSECURE_AUTH=false

# 세션 쿠키 Secure 속성 — MORI_PUBLIC_URL 이 https:// 면 자동 활성. 강제하려면 true.
# HTTP 데모에서는 Secure 쿠키가 전송되지 않아 로그인이 끊기므로 기본 비활성.
MORI_COOKIE_SECURE=false

# 공개 접속 URL(예: https://mori.example.com). https 면 세션 쿠키 Secure 자동 활성 +
# CSRF Origin allowlist 에 포함된다.
# MORI_PUBLIC_URL=
# CSRF 허용 추가 Origin(쉼표구분, 리버스프록시/다른 도메인에서 UI 접근 시).
# MORI_ALLOWED_ORIGINS=

# 로그인 브루트포스 잠금: (username,ip) 별 N회 실패 시 지정 초 동안 429.
# MORI_LOGIN_MAX_FAILURES=5
# MORI_LOGIN_LOCKOUT_SECONDS=900
# 세션 수명(초): 미활동(idle) 8시간 / 절대(absolute) 7일 기본. 초과 시 서버측 무효화.
# MORI_SESSION_IDLE_SECONDS=28800
# MORI_SESSION_ABSOLUTE_SECONDS=604800

# 시크릿 주입(운영): 평문 대신 파일 마운트를 쓰려면 <NAME>_FILE 로 파일 경로를 주면
#   부팅 시 그 파일 내용이 <NAME> 으로 로드된다(Docker/K8s secrets 규칙). 예:
#   MORI_ADMIN_PASSWORD_FILE=/run/secrets/admin_pw  ·  MORI_INGEST_TOKEN_FILE=/run/secrets/ingest
#   (로그에 새는 시크릿 값은 자동 마스킹된다.)

# MORI 관리자 계정 비밀번호 — 데모 기본값(문서·다른 데모 계정과 일치: admin/1234).
# 운영 배포 시 반드시 강력한 값으로 변경할 것(부팅 시 약한 기본값 경고가 뜬다).
# Demo credentials are intentionally simple for isolated demo use only.
MORI_ADMIN_PASSWORD=1234

# 데모 임팩트용 인메모리 시드 (triage/asset owners/user profiles). 운영에선 0 으로 비활성화
MORI_DEMO_SEED=1

# ── MORI LDAP 인증 (선택 — 기본 OFF) ──────────────────────────────────────────
#   MORI_LDAP_ENABLED=true 로 켜면: 로그인은 LDAP → 로컬 계정 순으로 인증하고,
#   가입 승인(admin) 시 계정이 LDAP 디렉터리에 생성되어 같은 LDAP을 보는
#   Grafana/Zabbix/Fleet 에서도 로그인된다. OFF면 로컬 계정만 사용(LDAP 불필요).
#   → 문서: docs/LDAP_INTEGRATION.md
MORI_LDAP_ENABLED=false
MORI_LDAP_URL=ldap://openldap:389
MORI_LDAP_BIND_DN=cn=admin,dc=mori,dc=local
# 바인드 비밀번호(쓰기 권한 필요 — 가입 승인 시 계정 생성). 번들은 LDAP_ADMIN_PASSWORD 와 동일.
MORI_LDAP_BIND_PASSWORD=change_this_ldap_admin_password
MORI_LDAP_BASE_DN=ou=users,dc=mori,dc=local
MORI_LDAP_USER_ATTR=uid

# MORI LDAP 계정·권한 수집기 (Worker — 디렉터리 동기화)
MORI_ENABLE_LDAP_SYNC=false
MORI_LDAP_SYNC_BASE_DN=dc=mori,dc=local
MORI_LDAP_SYNC_USER_FILTER=(objectClass=user)
MORI_LDAP_SYNC_GROUP_FILTER=(objectClass=group)
MORI_LDAP_SYNC_TIMEOUT_SECONDS=10

# Grafana LDAP
GRAFANA_LDAP_ENABLED=false

# Zabbix LDAP
ZABBIX_LDAP_ENABLED=false

# ── 통제 카탈로그 법령 NLP 임포트 (선택 — 기본 OFF) ────────────────────────────
#   컴플라이언스 탭 "📥 법령 텍스트 임포트(NLP)"에서 CISA·개인정보보호법·고시 전문을
#   붙여넣으면 통제 초안(draft)으로 자동 변환·저장(admin 전용).
#   - 키가 있으면: Claude API 로 정밀 구조화(붙여넣은 텍스트가 Anthropic 으로 전송됨).
#   - 비우면    : 외부 전송 없이 조항 단위 오프라인 휴리스틱으로 초안 생성.
#   → 민감 텍스트는 키를 비워 두어 오프라인 경로만 사용할 것.
MORI_ANTHROPIC_API_KEY=
MORI_NLP_MODEL=claude-haiku-4-5-20251001

# 원격 인제스트 토큰 (에이전트/CSOP 가 무세션 push 시 사용).
#  - POST /ingest/trivy    : 원본 Trivy 리포트 → 자체 정규화·적재.
#                            ?hostname= / X-MORI-Hostname 헤더 / 본문 hostname 으로
#                            이미지 스캔을 실제 호스트에 매핑(미지정 시 ArtifactName 파생).
#  - POST /ingest/evidence : CSOP 조치 전/후 diff envelope(delta_type new/fixed/reopened)
#                            → ui_evidence_events 적재. 조회는 GET /evidence(admin·security 전용).
# 인증: Authorization: Bearer <값> 또는 X-MORI-Token 헤더. 비우면 로그인 세션 필요.
# 운영에선 랜덤 토큰 권장 → openssl rand -hex 32
MORI_INGEST_TOKEN=

# 스캐너 자산 버전 라벨(무결성 매니페스트에 노출 — 고객이 버전 핀에 사용).
# MORI_SCANNER_VERSION=v0.6.0

# Rate limiting(#12): /ingest·/auth/login 남용 방지(IP·창당). 기본 넉넉, false 로 끌 수 있음.
# MORI_RATELIMIT_ENABLED=true
# MORI_RATELIMIT_WINDOW_SECONDS=60
# MORI_RATELIMIT_INGEST_MAX=300
# MORI_RATELIMIT_LOGIN_MAX=60

# 입력 한도(#36): 요청 본문 최대 바이트(초과 413) · ingest findings 상한(초과분 로그 후 잘림).
# MORI_MAX_BODY_BYTES=10485760
# MORI_MAX_FINDINGS=20000
