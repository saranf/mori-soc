{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MORI Control",
  "description": "One ISMS-P certification criterion or ISO 27001 Annex A control. Bilingual (KO/EN).",
  "type": "object",
  "required": ["id", "framework", "title_ko", "title_en", "evidence_sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "e.g. '2.11.2' (ISMS-P) or 'A.8.8' (ISO)" },
    "framework": { "enum": ["isms-p", "iso27001"] },
    "version": { "type": "string", "description": "e.g. '2023' (ISMS-P), '2022' (ISO)" },
    "domain": { "type": "string", "description": "Top category. e.g. '2. 보호대책 요구사항'" },
    "section": { "type": "string", "description": "Sub category. e.g. '2.11 사고 예방 및 대응'" },
    "title_ko": { "type": "string" },
    "title_en": { "type": "string" },
    "intent_ko": { "type": "string", "description": "Intent summary (KO)" },
    "intent_en": { "type": "string", "description": "Intent summary (EN)" },
    "evidence_sources": {
      "type": "array",
      "description": "MORI sources that produce evidence for this control",
      "items": { "enum": ["zabbix", "wazuh", "fleet", "trivy", "loki", "mori"] }
    },
    "evidence_hint_ko": { "type": "string", "description": "How this control is satisfied, as evidence (KO)" },
    "evidence_hint_en": { "type": "string", "description": "How this control is satisfied, as evidence (EN)" },
    "mori_intents": { "type": "array", "items": { "type": "string" }, "description": "Related NLQ intents" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["draft", "reviewed"], "description": "'draft' = skeleton, needs verification against the official standard" }
  }
}
