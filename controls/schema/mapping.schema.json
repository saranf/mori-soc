{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MORI Control Mapping (ISMS-P ↔ ISO 27001)",
  "description": "ISMS-P 인증기준과 ISO 27001:2022 Annex A 통제의 N:M 크로스매핑.",
  "type": "object",
  "required": ["mappings"],
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["isms_p", "iso27001", "relation"],
        "additionalProperties": false,
        "properties": {
          "isms_p": { "type": "string", "description": "ISMS-P 인증기준 id" },
          "iso27001": { "type": "array", "items": { "type": "string" }, "description": "대응하는 ISO 통제 id(복수 가능)" },
          "relation": { "enum": ["equivalent", "subset", "superset", "related"] },
          "note_ko": { "type": "string" },
          "note_en": { "type": "string" }
        }
      }
    }
  }
}
